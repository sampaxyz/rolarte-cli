# === GoLand / JetBrains IDE Settings ===
# User-specific configuration (history, personal shelf, tabs, etc.)
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries
.idea/shelf

# Sensitive files / local storage
.idea/dataSources/
.idea/dataSources.local.xml
.idea/dataSources.ids
.idea/sqlDataSources.xml
.idea/dynamic.xml

# CMake / Native build artifacts if you use CGO
cmake-build-*/

# (Optional) Uncomment the next line if you want to ignore ALL IDE settings.
# However, JetBrains recommends sharing general project settings (like code style) with your team.
# .idea/

# === Go Language & Build Artifacts ===
# Compiled binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries built via `go test -c`
*.test

# Code coverage profiles and test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace files (should usually be local to your machine)
go.work
go.work.sum

# Local environment variables
.env
.env.*
